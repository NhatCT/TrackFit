# Copy these names into .env and replace every placeholder with a local secret.
# Do not commit .env.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_PASSWORD=replace-with-a-strong-trackfit-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Optional local service settings.
DB_URL=jdbc:mysql://mysql:3306/trackfitdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=trackfit
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
AI_RECO_URL=http://localhost:8000
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
